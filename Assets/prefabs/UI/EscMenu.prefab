  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022  <color=#FFC95AFF>Drag</color> a card from your hand onto the board
    to play it.\n\u2022  <color=#FFC95AFF>Right-click</color> to cancel actions (playing
    a card, attacking, etc).\n\u2022  <color=#FFC95AFF>Click</color> one of your
    minions, then click an enemy to attack it.\n\u2022  <color=#FFC95AFF>Hover</color>
    over an enemy to see how much damage the attack would do before you commit.\n\u2022 
    <color=#FFC95AFF>Hover</color> over any unit to see which spaces it can attack.\n\u2022 
    <color=#FFC95AFF>Hover</color> over the end-turn button to see which minions
    will move, get blocked, or stay still."
