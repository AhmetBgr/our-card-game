--- !u!114 &1911375266310102231
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8091413310458451458}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022  You win by bringing the enemy hero's <color=#FFC95AFF>Health</color>
    down to <color=#FFC95AFF>0</color>.\n\u2022  The board is a <color=#FFC95AFF>3\xD73</color>
    grid: you use the bottom row, the enemy uses the top row.\n\u2022  Turns switch
    back and forth, you go first, and you get full <color=#FFC95AFF>mana</color>
    again at the start of each of your turns.\n\u2022  Your max mana goes up by <color=#FFC95AFF>1</color>
    every round, up to <color=#FFC95AFF>10</color>.\n\u2022  You start with <color=#FFC95AFF>3
    cards</color>, draw <color=#FFC95AFF>1</color> more each turn, and can hold up
    to <color=#FFC95AFF>7 cards</color> at once.\n\u2022  When you summon a minion,
    you pick an empty spot on your back row for it to stand.\n\u2022  If that spot
    is taken, the minion already there gets pushed forward one space.\n\u2022  A
    new minion can't attack or move until your next turn, unless it has <color=#FFC95AFF>Overdrive</color>.\n\u2022 
    At the end of your turn, every minion you control steps forward one space, if
    they can.\n\u2022  If something is blocking a minion's path, they <color=#FFC95AFF>Clash</color>
    instead of moving, and usually no damage is dealt.\n\u2022  You can only attack
    enemies within range: melee units reach <color=#FFC95AFF>1 space</color>, ranged
    units reach <color=#FFC95AFF>2 spaces</color>.\n\u2022  The enemy hits you back
    when you attack, but only if you're standing within their range too.\n\u2022 
    A unit dies when its Health reaches <color=#FFC95AFF>0</color>, and its <color=#FFC95AFF>Breakdown</color>
    effect happens.\n\u2022  Heroes can't move, but they can hit back if attacked.\n\u2022 
    Heroes also have passive abilities that activate on their own, like when they
    get attacked.\n\u2022  The first time you play a card, a stronger version of
    it gets added to your deck.\n\u2022  If your deck runs out, you get to pick from
    <color=#FFC95AFF>3 strong cards</color> instead of drawing normally.\n\u2022 
    Picking a card this way costs your hero some Health, and it costs more each time
    it happens."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c902c5847e945b5428f4eb29622c257f, type: 2}
  m_sharedMaterial: {fileID: 1063647338759458002, guid: c902c5847e945b5428f4eb29622c257f,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4291940817
  m_fontColor: {r: 0.82, g: 0.82, b: 0.82, a: 1}
  m_enableVertexGradient: 0
  m_colorMode: 3
